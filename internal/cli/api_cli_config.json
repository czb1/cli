{
  "version": "1.0",
  "defaults": {
    "server": "https://omtool.rnd.huawei.com",
    "output": "json",
    "timeout": 30,
    "auth": {
      "type": "cookie",
      "cookie": "",
      "probe_path": "/list/infoModule/queryAll",
      "probe_body": "{}"
    }
  },
  "groups": {
    "auth": {
      "description": "登录认证与本地会话管理",
      "resources": [
        {
          "http": {
            "path": "/api/auth/login",
            "method": "POST"
          },
          "cli": {
            "action": "login",
            "description": "域账号登录并建立本地会话（Cookie 落盘，后续命令自动携带）",
            "example": "omres-cli auth login --username zhangsan --password-stdin < pass.txt"
          }
        }
      ]
    },
    "task": {
      "description": "工程/任务管理",
      "resources": [
        {
          "http": {
            "path": "/api/task/create",
            "method": "POST"
          },
          "cli": {
            "action": "create",
            "description": "新建工程/任务，响应的 extendData 即新工程的 taskId",
            "example": "omres-cli task create --body '{\"taskName\":\"percreate\",\"neType\":\"UNC\",\"productType\":\"0\"}'"
          }
        },
        {
          "http": {
            "path": "/api/autoGit/getMicroServices",
            "method": "GET"
          },
          "cli": {
            "action": "pull-branch",
            "description": "拉取 Git 分支并返回可选微服务列表",
            "example": "omres-cli task pull-branch --repositoryUrl 'ssh://git@code.example.com:2222/group/project.git' --branchName refs/heads/main --taskId 12345 --taskName demo --resolveConflict 0"
          }
        },
        {
          "http": {
            "path": "/api/autoGit/autoDisplayResource",
            "method": "POST"
          },
          "cli": {
            "action": "resource-types",
            "description": "选择微服务并返回可导入的资源类型",
            "example": "omres-cli task resource-types --body '{\"microService\":\"ompublic\",\"taskId\":12345,\"taskName\":\"demo\"}'"
          }
        },
        {
          "http": {
            "path": "/myapi/upload/isEmptyProject",
            "method": "POST"
          },
          "cli": {
            "action": "is-empty",
            "description": "判断工程是否为空",
            "example": "omres-cli task is-empty --body '{\"taskId\":12345}'"
          }
        },
        {
          "http": {
            "path": "/api/autoGit/blacklistJudge",
            "method": "POST"
          },
          "cli": {
            "action": "blacklist-check",
            "description": "导入前执行 Git 模型黑名单校验",
            "example": "omres-cli task blacklist-check --body '{\"gitForm\":{\"repositoryUrl\":\"ssh://git@code.example.com:2222/group/project.git\",\"branchName\":\"refs/heads/main\",\"microService\":\"ompublic\",\"importTags\":\"perf\",\"importModuleTreeJson\":\"[]\"},\"taskId\":12345}'"
          }
        },
        {
          "http": {
            "path": "/api/autoGit/importInfoFormGit",
            "method": "POST"
          },
          "cli": {
            "action": "import-git",
            "description": "使用 Git 仓库导入 5G 建模模型到已有工程",
            "example": "omres-cli task import-git --body '{\"gitForm\":{\"repositoryUrl\":\"ssh://git@code.example.com:2222/group/project.git\",\"branchName\":\"refs/heads/main\",\"microService\":\"ompublic\",\"importTags\":\"perf\",\"importModuleTreeJson\":\"[]\"},\"taskId\":12345,\"taskName\":\"demo\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/task/exportStruct/{taskId}/{taskName}/{version}",
            "method": "POST"
          },
          "cli": {
            "action": "export-struct",
            "description": "导出Go Struct信息（异步任务）。第3个路径参数实际为 isIncludeAlarmCarding(0/1)",
            "example": "omres-cli task export-struct 123 demo 0"
          }
        },
        {
          "http": {
            "path": "/sbbapi/task/getExportStructResult/{taskId}/{taskName}",
            "method": "GET"
          },
          "cli": {
            "action": "export-result",
            "description": "获取导出Go Struct/告警中间件的异步任务结果（告警导出第1步）",
            "example": "omres-cli task export-result 2947 UDG_20_X_Master"
          }
        },
        {
          "http": {
            "path": "/sbbapi/task/download/{taskId}/{taskName}",
            "method": "GET"
          },
          "cli": {
            "action": "download",
            "description": "下载导出结果文件（二进制，自动保存到临时文件。告警导出第2步）",
            "example": "omres-cli task download 2947 UDG_20_X_Master"
          }
        },
        {
          "http": {
            "path": "/sbbapi/task/exportValidate/",
            "method": "POST"
          },
          "cli": {
            "action": "export-validate",
            "description": "导出前校验（路径末尾斜杠为后端要求）",
            "example": "omres-cli task export-validate --body '{\"taskId\":2947}'"
          }
        },
        {
          "http": {
            "path": "/api/task/isTaskIncludeAlarm",
            "method": "POST"
          },
          "cli": {
            "action": "include-alarm",
            "description": "判断工程是否含有告警（multipart 表单，参数用 --taskId 而非 --body）",
            "example": "omres-cli task include-alarm --taskId 2947"
          }
        },
        {
          "http": {
            "path": "/api/task/deleteOne",
            "method": "POST"
          },
          "cli": {
            "action": "delete-one",
            "description": "删除单个工程/任务（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli task delete-one --body '{\"taskId\":48050}' --yes"
          }
        },
        {
          "http": {
            "path": "/api/task/deleteMany",
            "method": "POST"
          },
          "cli": {
            "action": "delete-many",
            "description": "批量删除工程/任务（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli task delete-many --body '{\"idList\":[48314]}' --yes"
          }
        }
      ]
    },
    "upload": {
      "description": "文件上传与解析",
      "resources": [
        {
          "http": {
            "path": "/api/upload/uploadFile",
            "method": "POST"
          },
          "cli": {
            "action": "file",
            "description": "上传并解压zip/rar文件（multipart）",
            "example": "omres-cli upload file --taskId 123 --file ./model.zip"
          }
        },
        {
          "http": {
            "path": "/longtime/upload/parseXml",
            "method": "POST"
          },
          "cli": {
            "action": "parse-xml",
            "description": "解析解压后的XML文件",
            "example": "omres-cli upload parse-xml --body '{\"path\":\"/data\",\"fileName\":\"a.xml\",\"taskId\":\"123\",\"flag\":\"false\"}'"
          }
        }
      ]
    },
    "moc": {
      "description": "MOC（管理对象类）管理",
      "resources": [
        {
          "http": {
            "path": "/sbbapi/moc/addMocName",
            "method": "POST"
          },
          "cli": {
            "action": "add-name",
            "description": "新增MOC名称",
            "example": "omres-cli moc add-name --body '{\"mocName\":\"BoardInfo\",\"moduleId\":\"1\",\"taskId\":\"123\",\"mocDescCh\":\"单板\",\"mocDescEn\":\"Board\",\"mocTypeId\":\"1\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/moc/selectMocName",
            "method": "POST"
          },
          "cli": {
            "action": "select-name",
            "description": "查询MOC名称列表",
            "example": "omres-cli moc select-name --body '{\"taskId\":\"123\",\"moduleId\":\"1\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/moc/insertMocInfo",
            "method": "POST"
          },
          "cli": {
            "action": "insert-info",
            "description": "插入/更新MOC完整信息"
          }
        },
        {
          "http": {
            "path": "/sbbapi/moc/generateScriptFile/{taskId}/{mocId}/{mocName}/{scriptOper}/{isGenerateCode}",
            "method": "GET"
          },
          "cli": {
            "action": "generate-script",
            "description": "生成LUA脚本文件并下载（二进制）",
            "example": "omres-cli moc generate-script 123 10 BoardInfo add 1"
          }
        }
      ]
    },
    "moc-field": {
      "description": "MOC字段/属性管理",
      "resources": [
        {
          "http": {
            "path": "/sbbapi/mocField/addMocFieldName",
            "method": "POST"
          },
          "cli": {
            "action": "add-name",
            "description": "为MOC添加字段名称",
            "example": "omres-cli moc-field add-name --body '{\"mocId\":\"10\",\"fieldName\":\"port\",\"taskId\":\"123\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/mocField/selectMocFieldName",
            "method": "POST"
          },
          "cli": {
            "action": "select-name",
            "description": "查询MOC字段列表",
            "example": "omres-cli moc-field select-name --body '{\"taskId\":\"123\",\"mocId\":\"10\",\"moduleId\":\"1\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/mocField/updateFieldInfo",
            "method": "POST"
          },
          "cli": {
            "action": "update-info",
            "description": "更新MOC字段/属性信息"
          }
        }
      ]
    },
    "datatype": {
      "description": "自定义数据类型与枚举",
      "resources": [
        {
          "http": {
            "path": "/list/customize/datatype/add",
            "method": "POST"
          },
          "cli": {
            "action": "add",
            "description": "添加自定义数据类型（枚举/扩展枚举）",
            "example": "omres-cli datatype add --body '{\"projectId\":123,\"cdt\":{\"dataType\":\"MyEnum\"}}'"
          }
        },
        {
          "http": {
            "path": "/list/customize/datatype/queryAll",
            "method": "POST"
          },
          "cli": {
            "action": "query-all",
            "description": "查询所有自定义数据类型",
            "example": "omres-cli datatype query-all --body '{\"projectId\":123}'"
          }
        },
        {
          "http": {
            "path": "/list/customize/datatype/enum/add",
            "method": "POST"
          },
          "cli": {
            "action": "enum-add",
            "description": "为自定义数据类型添加枚举项",
            "example": "omres-cli datatype enum-add --body '{\"projectId\":123,\"enumsTable\":{\"enumItemName\":\"ON\",\"enumDatatypeNameId\":5}}'"
          }
        },
        {
          "http": {
            "path": "/list/customize/datatype/enum/queryAll",
            "method": "POST"
          },
          "cli": {
            "action": "enum-query-all",
            "description": "根据数据类型名称ID查询所有枚举项",
            "example": "omres-cli datatype enum-query-all --body '{\"enumDatatypeNameId\":5}'"
          }
        }
      ]
    },
    "default-record": {
      "description": "MOC默认记录",
      "resources": [
        {
          "http": {
            "path": "/sbbapi/defaultRecord/add",
            "method": "POST"
          },
          "cli": {
            "action": "add",
            "description": "为MOC添加默认记录",
            "example": "omres-cli default-record add --body '{\"mocId\":10,\"taskId\":123,\"defaultRecords\":{}}'"
          }
        }
      ]
    },
    "method": {
      "description": "MML方法/命令名称",
      "resources": [
        {
          "http": {
            "path": "/sbbapi/method/addMethodName",
            "method": "POST"
          },
          "cli": {
            "action": "add-name",
            "description": "为MOC添加MML方法/命令",
            "example": "omres-cli method add-name --body '{\"commandType\":\"Add\",\"mocId\":\"10\",\"taskId\":\"123\",\"mocTypeId\":\"1\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/method/updateMethodName",
            "method": "POST"
          },
          "cli": {
            "action": "update-name",
            "description": "更新MML方法/命令信息"
          }
        },
        {
          "http": {
            "path": "/sbbapi/method/deleteMethodName",
            "method": "POST"
          },
          "cli": {
            "action": "delete-name",
            "description": "删除MML方法/命令",
            "example": "omres-cli method delete-name --body '{\"methodIds\":\"1,2\",\"taskId\":\"123\",\"moduleName\":\"m1\"}'"
          }
        },
        {
          "http": {
            "path": "/sbbapi/method/selectMethodInfo",
            "method": "POST"
          },
          "cli": {
            "action": "select-info",
            "description": "查询MOC关联的MML方法信息",
            "example": "omres-cli method select-info --body '{\"taskId\":\"123\",\"mocId\":\"10\"}'"
          }
        }
      ]
    },
    "mml-command": {
      "description": "MML命令",
      "resources": [
        {
          "http": {
            "path": "/api/mmlCommand/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改MML命令"
          }
        },
        {
          "http": {
            "path": "/api/mmlCommand/selectByIdMmlCommand",
            "method": "POST"
          },
          "cli": {
            "action": "get",
            "description": "根据ID查询MML命令详情",
            "example": "omres-cli mml-command get --body '{\"id\":100}'"
          }
        }
      ]
    },
    "command-para": {
      "description": "命令参数",
      "resources": [
        {
          "http": {
            "path": "/api/commandPara/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改命令参数"
          }
        },
        {
          "http": {
            "path": "/api/commandPara/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询命令参数列表",
            "example": "omres-cli command-para list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "mml-para": {
      "description": "MML参数",
      "resources": [
        {
          "http": {
            "path": "/api/mmlPara/list1",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询MML参数列表（新增参数场景）",
            "example": "omres-cli mml-para list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "command-branch": {
      "description": "命令分支",
      "resources": [
        {
          "http": {
            "path": "/api/commandBranch/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改命令分支"
          }
        },
        {
          "http": {
            "path": "/api/commandBranch/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询命令分支列表",
            "example": "omres-cli command-branch list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "validate": {
      "description": "模型数据校验",
      "resources": [
        {
          "http": {
            "path": "/api/validate/do",
            "method": "POST"
          },
          "cli": {
            "action": "do",
            "description": "执行模型数据校验",
            "example": "omres-cli validate do --body '{\"projectId\":123}'"
          }
        },
        {
          "http": {
            "path": "/api/validate/result",
            "method": "POST"
          },
          "cli": {
            "action": "result",
            "description": "获取存储的校验结果",
            "example": "omres-cli validate result --body '{\"projectId\":123,\"level\":\"ERROR\"}'"
          }
        }
      ]
    },
    "errorcode": {
      "description": "错误码屏蔽",
      "resources": [
        {
          "http": {
            "path": "/api/errorcode/shield",
            "method": "POST"
          },
          "cli": {
            "action": "shield",
            "description": "设置需要屏蔽的错误码规则",
            "example": "omres-cli errorcode shield --body '{\"projectId\":123,\"shieldErrorCodes\":\"3001,3002\"}'"
          }
        }
      ]
    },
    "info-code": {
      "description": "错误码（信息码）管理",
      "resources": [
        {
          "http": {
            "path": "/list/infoCode/add",
            "method": "POST"
          },
          "cli": {
            "action": "add",
            "description": "添加错误码",
            "example": "omres-cli info-code add --body '{\"projectId\":123,\"infoCode\":{\"infoModuleId\":1,\"infoCodeName\":\"ERR_X\"}}'"
          }
        },
        {
          "http": {
            "path": "/list/infoCode/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询错误码列表（后端实际路径 /infoCode/queryAll）",
            "example": "omres-cli info-code list --body '{\"projectId\":123}'"
          }
        }
      ]
    },
    "info-module": {
      "description": "信息模块",
      "resources": [
        {
          "http": {
            "path": "/list/infoModule/queryAll",
            "method": "POST"
          },
          "cli": {
            "action": "query-all",
            "description": "根据项目ID查询所有信息模块",
            "example": "omres-cli info-module query-all --body '{\"projectId\":123}'"
          }
        }
      ]
    },
    "overallview": {
      "description": "全局概览查询",
      "resources": [
        {
          "http": {
            "path": "/myapi/overallview/search",
            "method": "POST"
          },
          "cli": {
            "action": "search",
            "description": "搜索项目模块概览，获取serviceName到moduleId的映射",
            "example": "omres-cli overallview search --body '{\"projectId\":\"123\"}'"
          }
        },
        {
          "http": {
            "path": "/myapi/overallview/getAllMicroService",
            "method": "GET"
          },
          "cli": {
            "action": "micro-service-list",
            "description": "查询全部微服务，用于把实际服务名（如SmcExecSvc）映射到belongService服务ID",
            "example": "omres-cli overallview micro-service-list"
          }
        }
      ]
    },
    "resource": {
      "description": "资源/性能指标管理",
      "resources": [
        {
          "http": {
            "path": "/api/resource/perf/idRange/autoGenId",
            "method": "GET"
          },
          "cli": {
            "action": "auto-gen-id",
            "description": "自动生成性能指标ID（支持metric和mu两种类型）",
            "example": "omres-cli resource auto-gen-id --neName UNC --belongService 203 --idType metric --taskId 47754 --muId 9"
          }
        },
        {
          "http": {
            "path": "/api/resource/perf/northIdRange/autoGenId",
            "method": "GET"
          },
          "cli": {
            "action": "north-auto-gen-id",
            "description": "自动生成网管侧（北向）测量单元ID/指标ID，即 nmMuId 与 nmMetricId；belongService 用网管侧服务ID（如114）",
            "example": "omres-cli resource north-auto-gen-id --neName UNC --belongService 114 --idType mu --checkDeleted false"
          }
        }
      ]
    },
    "perf": {
      "description": "性能维度、测量对象、指标组（测量单元）与指标注册",
      "resources": [
        {
          "http": {
            "path": "/bxapi/perf/baseinfo/dimension",
            "method": "POST"
          },
          "cli": {
            "action": "dimension-add",
            "description": "注册维度（供测量对象的 dimensionNoList 引用），查询参数是 projectId（值即 taskId）",
            "example": "omres-cli perf dimension-add --projectId 47754 --body '{\"dimensionId\":\"56\",\"dimensionName\":\"5qi\",\"dimensionDataLength\":\"128\",\"stringResId\":\"AAA_17\",\"microService\":[\"basicBizService\",\"203\"],\"CheckMode\":\"ALL\",\"belongService\":\"203\"}'"
          }
        },
        {
          "http": {
            "path": "/bxapi/perf/class/{belongService}/{mocId}",
            "method": "PUT"
          },
          "cli": {
            "action": "object-add",
            "description": "注册（新增/修改）性能测量对象，路径参数依次是 belongService 与 mocId，须与请求体中的同名字段一致",
            "example": "omres-cli perf object-add 203 36 --projectId 47754 --body-file ./moc.json"
          }
        },
        {
          "http": {
            "path": "/api/perf/object/indicatorGroup/insert",
            "method": "POST"
          },
          "cli": {
            "action": "indicator-group-add",
            "description": "新建指标组（测量单元）并向网管注册，muId 与 nmMuId 需先由 resource auto-gen-id / north-auto-gen-id 取得",
            "example": "omres-cli perf indicator-group-add --taskId 47754 --body '{\"mocId\":6,\"mocChName\":\"RATTYPE\",\"belongService\":203,\"serviceInfo\":\"basicBizService/ompublic\",\"realServiceNames\":[\"SmcExecSvc\"],\"realServicesName\":\"SmcExecSvc\",\"nmMfId\":1929445378,\"muId\":\"55\",\"muName\":\"指定RATTYPE的CGW 4G会话管理失败流程\",\"monitorType\":1,\"dimensionsCalc\":\"否\",\"isRealTimeMonitor\":\"否\",\"defaultPeriod\":\"5\",\"isCombine\":\"是\",\"isHide\":\"否\",\"stringResId\":\"MU_12156\",\"nmMuId\":\"1929445469\"}'"
          }
        },
        {
          "http": {
            "path": "/api/perf/object/indicator/manage",
            "method": "POST"
          },
          "cli": {
            "action": "indicator-add",
            "description": "在指标组下登记指标ID与名称（新增指标第一步），随后用 indicator-update 补齐完整属性",
            "example": "omres-cli perf indicator-add --taskId 47754 --belongService 203 --body '{\"metricId\":\"103856\",\"metricName\":\"指定RATTYPE的CGW发送 PDU Session Establishment Reject消息数\",\"meType\":0,\"belongService\":203,\"muId\":55}'"
          }
        },
        {
          "http": {
            "path": "/api/perf/object/indicator",
            "method": "POST"
          },
          "cli": {
            "action": "indicator-update",
            "description": "保存指标完整属性并向网管注册（算法、值类型、语言资源、测量点、nmMetricId 等）",
            "example": "omres-cli perf indicator-update --taskId 47754 --metricId 103856 --belongService 203 --body-file ./indicator.json"
          }
        },
        {
          "http": {
            "path": "/api/perf/baseInfo/languageResource/insert",
            "method": "POST"
          },
          "cli": {
            "action": "language-resource-add",
            "description": "注册语言资源（指标组/指标的中英文描述），stringResId 要与指标组的 stringResId、指标的 meStringResId 对应",
            "example": "omres-cli perf language-resource-add --taskId 47754 --body '{\"stringResId\":\"MU_55\",\"descriptionZh\":\"指定RATTYPE的CGW 4G会话管理失败流程\",\"descriptionEn\":\"Failed CGW 4G session management procedures for a specific RAT type\",\"belongService\":\"203\"}'"
          }
        },
        {
          "http": {
            "path": "/api/perf/baseInfo/languageResource/delete/batch",
            "method": "POST"
          },
          "cli": {
            "action": "language-resource-delete",
            "description": "批量删除语言资源，请求体是记录数组（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli perf language-resource-delete --taskId 47754 --body '[{\"stringResId\":\"MU_55\",\"descriptionZh\":\"指定RATTYPE的CGW 4G会话管理失败流程\",\"descriptionEn\":\"Failed CGW 4G session management procedures for a specific RAT type\",\"remark\":null,\"belongService\":203}]' --yes"
          }
        },
        {
          "http": {
            "path": "/api/perf/object/indicatorGroup/delete/batch",
            "method": "POST"
          },
          "cli": {
            "action": "indicator-group-delete",
            "description": "批量删除指标组（测量单元），请求体是记录数组；应先删掉其下的指标（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli perf indicator-group-delete --taskId 47754 --body-file ./mu-delete.json --yes"
          }
        },
        {
          "http": {
            "path": "/api/perf/object/indicator/manage/delete",
            "method": "POST"
          },
          "cli": {
            "action": "indicator-delete",
            "description": "批量删除指标，请求体是记录数组，元素可直接回传 indicator-update 用过的记录（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli perf indicator-delete --taskId 47754 --body-file ./metric-delete.json --yes"
          }
        },
        {
          "http": {
            "path": "/bxapi/perf/class/multiDel",
            "method": "DELETE"
          },
          "cli": {
            "action": "object-delete",
            "description": "批量删除性能测量对象，删除前要先删掉其下的指标与指标组（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli perf object-delete --projectId 47754 --body '{\"perfClassList\":[{\"mocId\":\"36\",\"belongService\":203,\"nmMocId\":1929445387}]}' --yes"
          }
        },
        {
          "http": {
            "path": "/bxapi/perf/baseinfo/dimension/multiDel",
            "method": "DELETE"
          },
          "cli": {
            "action": "dimension-delete",
            "description": "批量删除维度，删除前要先删掉引用该维度的测量对象（破坏性操作，需要 --yes 确认）",
            "example": "omres-cli perf dimension-delete --projectId 47754 --body '{\"dimensionList\":[{\"dimensionId\":\"56\",\"belongService\":203}]}' --yes"
          }
        }
      ]
    },
    "alarm-service": {
      "description": "告警服务",
      "resources": [
        {
          "http": {
            "path": "/api/alarmService/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改告警服务（新增时 id 传空字符串）",
            "example": "omres-cli alarm-service upsert --body '{\"taskId\":2947,\"alarmServiceTable\":{\"id\":\"\",\"serviceName\":\"test\",\"microServiceType\":\"udgService\",\"microServiceName\":\"udgompublic\"}}'"
          }
        },
        {
          "http": {
            "path": "/api/alarmService/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询告警服务列表，按 serviceName 反查其 id（即后续的 serviceId）",
            "example": "omres-cli alarm-service list --body '{\"taskId\":2947}'"
          }
        }
      ]
    },
    "alarm": {
      "description": "告警",
      "resources": [
        {
          "http": {
            "path": "/api/alarm/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改告警。新建只需 serviceId+中英文名（id 传空字符串）；补全配置时回传 list 拿到的 id/serviceId/alarmId 及级别、分类等字段",
            "example": "omres-cli alarm upsert --body '{\"taskId\":2947,\"alarmTable\":{\"id\":\"\",\"serviceId\":92,\"alarmChineseName\":\"alarmtest_cn\",\"alarmEnglishName\":\"alarmtest_en\"}}'"
          }
        },
        {
          "http": {
            "path": "/api/alarm/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询指定告警服务下的告警列表。返回的 id 是内部主键（后续 alarmInternalId 用它），alarmId 是后端分配的告警号字符串",
            "example": "omres-cli alarm list --body '{\"taskId\":2947,\"serviceId\":92}'"
          }
        }
      ]
    },
    "alarm-enum": {
      "description": "告警枚举类型",
      "resources": [
        {
          "http": {
            "path": "/api/alarmEnum/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改告警枚举类型（alarmInternalId 为告警内部主键 id）",
            "example": "omres-cli alarm-enum upsert --body '{\"taskId\":2947,\"alarmEnumTable\":{\"id\":\"\",\"alarmInternalId\":96,\"enumType\":\"2\",\"enumName\":\"ENUMTEST\"}}'"
          }
        },
        {
          "http": {
            "path": "/api/alarmEnum/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询告警枚举类型列表。入参名虽叫 alarmId，实际传告警内部主键 id；返回的 id 即枚举值的 enumTypeId",
            "example": "omres-cli alarm-enum list --body '{\"taskId\":2947,\"alarmId\":96}'"
          }
        }
      ]
    },
    "alarm-enum-value": {
      "description": "告警枚举值",
      "resources": [
        {
          "http": {
            "path": "/api/alarmEnumValue/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改告警枚举值（enumTypeId 取自 alarm-enum list 返回的 id）",
            "example": "omres-cli alarm-enum-value upsert --body '{\"taskId\":2947,\"alarmEnumValueTable\":{\"enumTypeId\":56,\"iValue\":\"0\",\"englishSvalue\":\"engname\",\"chineseSvalue\":\"中文枚举名\",\"itemMeanEn\":\"NA\",\"itemMeanCh\":\"中文含义\"}}'"
          }
        }
      ]
    },
    "alarm-para": {
      "description": "告警参数",
      "resources": [
        {
          "http": {
            "path": "/api/alarmPara/insertOrUpdate",
            "method": "POST"
          },
          "cli": {
            "action": "upsert",
            "description": "新增或修改告警参数。先只传 alarmInternalId+paramEnglishAbbreviationName 建占位，再用 list 拿到 id 与 paramOrder 后回传完整字段补全",
            "example": "omres-cli alarm-para upsert --body '{\"taskId\":2947,\"isAllowEdit\":1,\"alarmParaTable\":{\"alarmInternalId\":96,\"paramEnglishAbbreviationName\":\"PODNAME\"}}'"
          }
        },
        {
          "http": {
            "path": "/api/alarmPara/list",
            "method": "POST"
          },
          "cli": {
            "action": "list",
            "description": "查询告警参数列表。入参名虽叫 alarmId，实际传告警内部主键 id",
            "example": "omres-cli alarm-para list --body '{\"taskId\":2947,\"alarmId\":96}'"
          }
        }
      ]
    }
  }
}
