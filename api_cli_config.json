{
  "version": "1.0",
  "defaults": {
    "server": "http://10.243.80.228",
    "output": "json",
    "timeout": 30,
    "auth": {
      "type": "cookie",
      "cookie": ""
    }
  },
  "groups": {
    "auth": {
      "description": "登录认证",
      "resources": [
        {
          "http": { "path": "/api/auth/login", "method": "POST" },
          "cli": {
            "action": "login",
            "description": "域账号登录",
            "example": "omres-cli auth login --body '{\"userName\":\"zhangsan\",\"passwd\":\"******\"}'"
          }
        }
      ]
    },
    "task": {
      "description": "工程/任务管理",
      "resources": [
        {
          "http": { "path": "/api/task/create", "method": "POST" },
          "cli": {
            "action": "create",
            "description": "新建工程/任务",
            "example": "omres-cli task create --body '{\"taskName\":\"demo\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/task/exportStruct/{taskId}/{taskName}/{version}", "method": "POST" },
          "cli": {
            "action": "export-struct",
            "description": "导出Go Struct信息（异步任务）。第3个路径参数实际为 isIncludeAlarmCarding(0/1)",
            "example": "omres-cli task export-struct 123 demo 0"
          }
        },
        {
          "http": { "path": "/sbbapi/task/getExportStructResult/{taskId}/{taskName}", "method": "POST" },
          "cli": {
            "action": "export-result",
            "description": "获取导出Go Struct的异步任务结果",
            "example": "omres-cli task export-result 123 demo"
          }
        },
        {
          "http": { "path": "/sbbapi/task/download/{taskId}/{taskName}", "method": "GET" },
          "cli": {
            "action": "download",
            "description": "下载导出的Go Struct结果文件（二进制，自动保存到临时文件）",
            "example": "omres-cli task download 123 demo"
          }
        }
      ]
    },
    "upload": {
      "description": "文件上传与解析",
      "resources": [
        {
          "http": { "path": "/api/upload/uploadFile", "method": "POST" },
          "cli": {
            "action": "file",
            "description": "上传并解压zip/rar文件（multipart）",
            "example": "omres-cli upload file --taskId 123 --file ./model.zip"
          }
        },
        {
          "http": { "path": "/longtime/upload/parseXml", "method": "POST" },
          "cli": {
            "action": "parse-xml",
            "description": "解析解压后的XML文件",
            "example": "omres-cli upload parse-xml --body '{\"path\":\"/data\",\"fileName\":\"a.xml\",\"taskId\":\"123\",\"flag\":\"false\"}'"
          }
        }
      ]
    },
    "moc": {
      "description": "MOC（管理对象类）管理",
      "resources": [
        {
          "http": { "path": "/sbbapi/moc/addMocName", "method": "POST" },
          "cli": {
            "action": "add-name",
            "description": "新增MOC名称",
            "example": "omres-cli moc add-name --body '{\"mocName\":\"BoardInfo\",\"moduleId\":\"1\",\"taskId\":\"123\",\"mocDescCh\":\"单板\",\"mocDescEn\":\"Board\",\"mocTypeId\":\"1\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/moc/selectMocName", "method": "POST" },
          "cli": {
            "action": "select-name",
            "description": "查询MOC名称列表",
            "example": "omres-cli moc select-name --body '{\"taskId\":\"123\",\"moduleId\":\"1\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/moc/insertMocInfo", "method": "POST" },
          "cli": {
            "action": "insert-info",
            "description": "插入/更新MOC完整信息"
          }
        },
        {
          "http": { "path": "/sbbapi/moc/generateScriptFile/{taskId}/{mocId}/{mocName}/{scriptOper}/{isGenerateCode}", "method": "GET" },
          "cli": {
            "action": "generate-script",
            "description": "生成LUA脚本文件并下载（二进制）",
            "example": "omres-cli moc generate-script 123 10 BoardInfo add 1"
          }
        }
      ]
    },
    "moc-field": {
      "description": "MOC字段/属性管理",
      "resources": [
        {
          "http": { "path": "/sbbapi/mocField/addMocFieldName", "method": "POST" },
          "cli": {
            "action": "add-name",
            "description": "为MOC添加字段名称",
            "example": "omres-cli moc-field add-name --body '{\"mocId\":\"10\",\"fieldName\":\"port\",\"taskId\":\"123\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/mocField/selectMocFieldName", "method": "POST" },
          "cli": {
            "action": "select-name",
            "description": "查询MOC字段列表",
            "example": "omres-cli moc-field select-name --body '{\"taskId\":\"123\",\"mocId\":\"10\",\"moduleId\":\"1\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/mocField/updateFieldInfo", "method": "POST" },
          "cli": {
            "action": "update-info",
            "description": "更新MOC字段/属性信息"
          }
        }
      ]
    },
    "datatype": {
      "description": "自定义数据类型与枚举",
      "resources": [
        {
          "http": { "path": "/list/customize/datatype/add", "method": "POST" },
          "cli": {
            "action": "add",
            "description": "添加自定义数据类型（枚举/扩展枚举）",
            "example": "omres-cli datatype add --body '{\"projectId\":123,\"cdt\":{\"dataType\":\"MyEnum\"}}'"
          }
        },
        {
          "http": { "path": "/list/customize/datatype/queryAll", "method": "POST" },
          "cli": {
            "action": "query-all",
            "description": "查询所有自定义数据类型",
            "example": "omres-cli datatype query-all --body '{\"projectId\":123}'"
          }
        },
        {
          "http": { "path": "/list/customize/datatype/enum/add", "method": "POST" },
          "cli": {
            "action": "enum-add",
            "description": "为自定义数据类型添加枚举项",
            "example": "omres-cli datatype enum-add --body '{\"projectId\":123,\"enumsTable\":{\"enumItemName\":\"ON\",\"enumDatatypeNameId\":5}}'"
          }
        },
        {
          "http": { "path": "/list/customize/datatype/enum/queryAll", "method": "POST" },
          "cli": {
            "action": "enum-query-all",
            "description": "根据数据类型名称ID查询所有枚举项",
            "example": "omres-cli datatype enum-query-all --body '{\"enumDatatypeNameId\":5}'"
          }
        }
      ]
    },
    "default-record": {
      "description": "MOC默认记录",
      "resources": [
        {
          "http": { "path": "/sbbapi/defaultRecord/add", "method": "POST" },
          "cli": {
            "action": "add",
            "description": "为MOC添加默认记录",
            "example": "omres-cli default-record add --body '{\"mocId\":10,\"taskId\":123,\"defaultRecords\":{}}'"
          }
        }
      ]
    },
    "method": {
      "description": "MML方法/命令名称",
      "resources": [
        {
          "http": { "path": "/sbbapi/method/addMethodName", "method": "POST" },
          "cli": {
            "action": "add-name",
            "description": "为MOC添加MML方法/命令",
            "example": "omres-cli method add-name --body '{\"commandType\":\"Add\",\"mocId\":\"10\",\"taskId\":\"123\",\"mocTypeId\":\"1\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/method/updateMethodName", "method": "POST" },
          "cli": {
            "action": "update-name",
            "description": "更新MML方法/命令信息"
          }
        },
        {
          "http": { "path": "/sbbapi/method/deleteMethodName", "method": "POST" },
          "cli": {
            "action": "delete-name",
            "description": "删除MML方法/命令",
            "example": "omres-cli method delete-name --body '{\"methodIds\":\"1,2\",\"taskId\":\"123\",\"moduleName\":\"m1\"}'"
          }
        },
        {
          "http": { "path": "/sbbapi/method/selectMethodInfo", "method": "POST" },
          "cli": {
            "action": "select-info",
            "description": "查询MOC关联的MML方法信息",
            "example": "omres-cli method select-info --body '{\"taskId\":\"123\",\"mocId\":\"10\"}'"
          }
        }
      ]
    },
    "mml-command": {
      "description": "MML命令",
      "resources": [
        {
          "http": { "path": "/api/mmlCommand/insertOrUpdate", "method": "POST" },
          "cli": {
            "action": "upsert",
            "description": "新增或修改MML命令"
          }
        },
        {
          "http": { "path": "/api/mmlCommand/selectByIdMmlCommand", "method": "POST" },
          "cli": {
            "action": "get",
            "description": "根据ID查询MML命令详情",
            "example": "omres-cli mml-command get --body '{\"id\":100}'"
          }
        }
      ]
    },
    "command-para": {
      "description": "命令参数",
      "resources": [
        {
          "http": { "path": "/api/commandPara/insertOrUpdate", "method": "POST" },
          "cli": {
            "action": "upsert",
            "description": "新增或修改命令参数"
          }
        },
        {
          "http": { "path": "/api/commandPara/list", "method": "POST" },
          "cli": {
            "action": "list",
            "description": "查询命令参数列表",
            "example": "omres-cli command-para list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "mml-para": {
      "description": "MML参数",
      "resources": [
        {
          "http": { "path": "/api/mmlPara/list1", "method": "POST" },
          "cli": {
            "action": "list",
            "description": "查询MML参数列表（新增参数场景）",
            "example": "omres-cli mml-para list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "command-branch": {
      "description": "命令分支",
      "resources": [
        {
          "http": { "path": "/api/commandBranch/insertOrUpdate", "method": "POST" },
          "cli": {
            "action": "upsert",
            "description": "新增或修改命令分支"
          }
        },
        {
          "http": { "path": "/api/commandBranch/list", "method": "POST" },
          "cli": {
            "action": "list",
            "description": "查询命令分支列表",
            "example": "omres-cli command-branch list --body '{\"commandId\":100}'"
          }
        }
      ]
    },
    "validate": {
      "description": "模型数据校验",
      "resources": [
        {
          "http": { "path": "/api/validate/do", "method": "POST" },
          "cli": {
            "action": "do",
            "description": "执行模型数据校验",
            "example": "omres-cli validate do --body '{\"projectId\":123}'"
          }
        },
        {
          "http": { "path": "/api/validate/result", "method": "POST" },
          "cli": {
            "action": "result",
            "description": "获取存储的校验结果",
            "example": "omres-cli validate result --body '{\"projectId\":123,\"level\":\"ERROR\"}'"
          }
        }
      ]
    },
    "errorcode": {
      "description": "错误码屏蔽",
      "resources": [
        {
          "http": { "path": "/api/errorcode/shield", "method": "POST" },
          "cli": {
            "action": "shield",
            "description": "设置需要屏蔽的错误码规则",
            "example": "omres-cli errorcode shield --body '{\"projectId\":123,\"shieldErrorCodes\":\"3001,3002\"}'"
          }
        }
      ]
    },
    "info-code": {
      "description": "错误码（信息码）管理",
      "resources": [
        {
          "http": { "path": "/list/infoCode/add", "method": "POST" },
          "cli": {
            "action": "add",
            "description": "添加错误码",
            "example": "omres-cli info-code add --body '{\"projectId\":123,\"infoCode\":{\"infoModuleId\":1,\"infoCodeName\":\"ERR_X\"}}'"
          }
        },
        {
          "http": { "path": "/list/infoCode/list", "method": "POST" },
          "cli": {
            "action": "list",
            "description": "查询错误码列表（后端实际路径 /infoCode/queryAll）",
            "example": "omres-cli info-code list --body '{\"projectId\":123}'"
          }
        }
      ]
    },
    "info-module": {
      "description": "信息模块",
      "resources": [
        {
          "http": { "path": "/list/infoModule/queryAll", "method": "POST" },
          "cli": {
            "action": "query-all",
            "description": "根据项目ID查询所有信息模块",
            "example": "omres-cli info-module query-all --body '{\"projectId\":123}'"
          }
        }
      ]
    }
  }
}
